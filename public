<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Al-Fauzan Center SMS</title>
<style>
:root{--green:#064d2e;--green2:#0b6b3d;--gold:#c89b2c;--cream:#fbf6e8;--red:#b42318;--ink:#182019;--muted:#68736b;--white:#fff;--line:#d9d2bd;--shadow:0 12px 35px rgba(0,0,0,.12)}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#eef5ef,#f8f3e5);color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:11px 15px;background:var(--green);color:white;font-weight:700}button.gold{background:var(--gold);color:#231b08}button.red{background:var(--red)}button.ghost{background:#edf2ee;color:var(--green)}button:disabled{opacity:.55;cursor:not-allowed}.hide{display:none!important}.top{background:linear-gradient(100deg,#04351f,#0a6339);color:#fff;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:15px;position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px}.brand img{width:50px;height:50px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);background:#fff}.brand h1{font-size:18px;margin:0}.brand small{opacity:.85}.wrap{max-width:1250px;margin:auto;padding:22px}.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(520px,100%);background:rgba(255,255,255,.97);border-radius:22px;box-shadow:var(--shadow);padding:25px;border:1px solid #e8e1cf}.login-head{text-align:center}.login-head img{width:105px;height:105px;object-fit:cover;border-radius:50%;border:4px solid var(--gold)}.login-head h1{color:var(--green);margin:10px 0 4px}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:20px 0}.tabs button{background:#edf2ee;color:var(--green)}.tabs button.active{background:var(--green);color:white}.field{margin:12px 0}.field label{display:block;font-weight:700;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:white;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(6,77,46,.1)}.notice{padding:12px;border-radius:10px;background:#f3f7f4;color:var(--green);margin:12px 0}.err{background:#fff0ef!important;color:var(--red)!important}.ok{background:#edf9f0!important;color:#166534!important}.app{min-height:100vh}.nav{display:flex;gap:8px;flex-wrap:wrap;padding:14px 18px;background:white;border-bottom:1px solid var(--line)}.nav button{background:#f1f4f1;color:#17351f;padding:9px 12px}.nav button.active{background:var(--green);color:#fff}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 4px 18px rgba(0,0,0,.05);margin-bottom:16px}.stat{font-size:30px;font-weight:900;color:var(--green)}.muted{color:var(--muted)}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:10px;border:1px solid var(--line);text-align:left}th{background:var(--green);color:#fff}.table-wrap{overflow:auto;border-radius:12px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.creator{display:flex;align-items:center;gap:14px}.creator-avatar{width:70px;height:70px;border-radius:50%;display:grid;place-items:center;background:var(--green);color:#fff;border:3px solid var(--gold);font-weight:900;font-size:24px}.creator-photo{width:78px;height:78px;border-radius:50%;object-fit:cover;border:3px solid var(--gold);background:#fff}.report-creator{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px;font-size:11px}.report-page{background:#fffdf5;border:10px solid var(--green);outline:4px solid var(--gold);outline-offset:-16px;padding:30px 28px;position:relative;min-height:1120px;overflow:hidden}.report-page:before{content:"";position:absolute;inset:14px;border:2px solid var(--gold);pointer-events:none}.report-inner{position:relative;z-index:1}.report-head{text-align:center}.report-head .logos{display:flex;justify-content:space-between;align-items:flex-start}.report-logo{width:90px;height:90px;object-fit:cover}.report-head h1{font-family:Georgia,serif;color:#17351f;font-size:37px;margin:4px 0}.report-head h2{color:#9a7622;font-family:Georgia,serif;margin:0 0 6px;font-size:21px}.report-head .address{font-weight:800}.report-title{width:430px;max-width:80%;margin:12px auto;background:var(--green);color:#fff;border:4px solid var(--gold);border-radius:24px;padding:8px 20px;font-size:22px;font-weight:900}.student-info{border:2px solid #222;border-radius:12px;padding:12px;margin:12px 0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;font-weight:700}.report-table{font-size:12px}.report-table th{text-align:center;background:var(--green)}.report-table td{text-align:center}.report-table td.subject{text-align:left;font-weight:700}.poor{color:var(--red)!important;font-weight:900}.summary{border:2px solid #222;border-radius:12px;padding:10px;margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:7px;font-weight:700}.remarks{border:2px solid #222;border-radius:12px;padding:10px;margin-top:10px}.remark-line{border-bottom:1px dotted #555;min-height:25px;margin:4px 0 7px}.signs{display:grid;grid-template-columns:1fr 1fr;gap:70px;margin-top:35px;text-align:center;font-weight:700}.sign-line{border-bottom:2px solid #222;margin-bottom:7px}.report-actions{text-align:center;margin-top:14px}.footer{text-align:center;margin:20px 0;color:#68736b;font-size:12px}.modal{position:fixed;inset:0;background:rgba(0,0,0,.55);display:grid;place-items:center;padding:15px;z-index:50}.modal-box{width:min(620px,100%);background:#fff;border-radius:18px;padding:20px;max-height:90vh;overflow:auto}.close{float:right;background:#eee;color:#333;padding:7px 10px}@media(max-width:750px){.student-info{grid-template-columns:1fr}.report-head h1{font-size:27px}.report-title{font-size:17px}.report-page{padding:22px 15px;border-width:7px}.report-table{font-size:9px}.signs{gap:20px}.top{position:relative}}@media print{body{background:white}.top,.nav,.report-actions,.footer,.no-print{display:none!important}.wrap{padding:0;max-width:none}.card{box-shadow:none;border:0;padding:0}.report-page{width:210mm;min-height:297mm;margin:0;border:7px solid var(--green);outline:3px solid var(--gold);outline-offset:-12px;padding:16mm 12mm}.report-head h1{font-size:30px}.report-logo{width:70px;height:70px}.report-table{font-size:9px}.report-table th,.report-table td{padding:5px}.report-page:before{inset:9px}.print-only{display:block!important}@page{size:A4 portrait;margin:0}}
</style></head>
<body>
<div id="loginView" class="login"><div class="login-card"><div class="login-head"><img src="assets/logo.png"><h1>AL-FAUZAN CENTER</h1><div>FOR QUR'AN AND GENERAL STUDIES</div><div class="muted">Kukar Auwale, Aliero, Kebbi State</div></div><div class="tabs"><button id="tabAdmin" class="active" onclick="setMode('admin')">Admin</button><button id="tabTeacher" onclick="setMode('teacher')">Teacher</button><button id="tabStudent" onclick="setMode('student')">Student</button></div><div id="loginForm"><div class="field"><label>Username</label><input id="username" autocomplete="username"></div><div class="field"><label>Password</label><input id="password" type="password" autocomplete="current-password"></div><button style="width:100%" onclick="login()">Login to Portal</button><div id="loginMsg" class="notice hide"></div><p id="teacherRegLink" class="muted" style="text-align:center">Teacher? <button class="ghost" onclick="showRegister()">Register here</button></p></div><div id="registerForm" class="hide"><h2>Teacher Registration</h2><div class="field"><label>Full Name</label><input id="rname"></div><div class="field"><label>Username</label><input id="ruser"></div><div class="field"><label>Email</label><input id="remail" type="email"></div><div class="field"><label>Password</label><input id="rpass" type="password"></div><button onclick="register()">Submit Registration</button> <button class="ghost" onclick="showLogin()">Back</button><div id="regMsg" class="notice hide"></div></div><div class="footer"><img class="creator-photo" src="assets/creator.jpg"><br>Software by <b>Usman Adamu Auwal</b> • 2025/2026</div></div></div>
<div id="appView" class="app hide"><div class="top"><div class="brand"><img src="assets/logo.png"><div><h1>AL-FAUZAN CENTER SMS</h1><small id="roleLine"></small></div></div><button class="gold" onclick="logout()">Logout</button></div><div id="nav" class="nav"></div><main class="wrap"><div id="main"></div></main></div>
<div id="modal" class="modal hide"><div class="modal-box"><button class="close" onclick="closeModal()">✕</button><div id="modalBody"></div></div></div>
<script>
const API='https://alfauzansms.onrender.com/api';let token=localStorage.getItem('af_token')||'',me=null,mode='admin',students=[],classes=[],subjects=[];const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function req(path,opt={}){const r=await fetch(API+path,{...opt,headers:{'Content-Type':'application/json',...(opt.headers||{}),...(token?{Authorization:'Bearer '+token}:{})}});let d={};try{d=await r.json()}catch{}if(!r.ok)throw new Error(d.error||'Request failed');return d}
function setMode(m){mode=m;['admin','teacher','student'].forEach(x=>$('tab'+x[0].toUpperCase()+x.slice(1)).classList.toggle('active',x===m));$('teacherRegLink').classList.toggle('hide',m!=='teacher');$('loginMsg').classList.add('hide');showLogin()}
function showRegister(){if(mode!=='teacher')return;$('loginForm').classList.add('hide');$('registerForm').classList.remove('hide')}
function showLogin(){$('registerForm').classList.add('hide');$('loginForm').classList.remove('hide')}
function msg(id,text,ok=false){$(id).textContent=text;$(id).className='notice '+(ok?'ok':'err')}
async function login(){try{const u=$('username').value.trim(),p=$('password').value;if(!u||!p)return msg('loginMsg','Enter username and password.');const d=await req('/auth/login',{method:'POST',body:JSON.stringify({username:u,password:p})});if(mode==='admin'&&d.user.role!=='admin')throw new Error('This is not an Admin account.');if(mode==='teacher'&&d.user.role!=='teacher')throw new Error('This is not a Teacher account.');if(mode==='student'&&d.user.role!=='student')throw new Error('This is not a Student account.');token=d.token;localStorage.setItem('af_token',token);me=d.user;openApp()}catch(e){msg('loginMsg',e.message)}}
async function register(){try{const d=await req('/auth/register',{method:'POST',body:JSON.stringify({name:$('rname').value,username:$('ruser').value,email:$('remail').value,password:$('rpass').value})});msg('regMsg',d.message,true)}catch(e){msg('regMsg',e.message)}}
async function openApp(){try{me=await req('/me');$('loginView').classList.add('hide');$('appView').classList.remove('hide');$('roleLine').textContent=`${me.name} • ${me.role.toUpperCase()}`;buildNav();home()}catch(e){logout()}}
function logout(){token='';localStorage.removeItem('af_token');me=null;$('appView').classList.add('hide');$('loginView').classList.remove('hide')}
function buildNav(){const admin=[['home','Dashboard'],['teachers','Teachers'],['classes','Classes'],['subjects','Subjects'],['assign','Assignments'],['students','Students'],['fees','Fees / Payments'],['notices','Notices'],['store','Store / Inventory'],['settings','Settings']];const teacher=[['home','Dashboard'],['students','My Students'],['addstudent','Add Student'],['marks','Add Marks'],['reports','Report Cards'],['attendance','Attendance'],['notices','Notices']];const student=[['home','My Dashboard'],['myreport','My Report Card'],['myattendance','My Attendance'],['notices','School Notices'],['fees','My Fees']];const arr=me.role==='admin'?admin:me.role==='teacher'?teacher:student;$('nav').innerHTML=arr.map(([id,t])=>`<button id="nav-${id}" onclick="go('${id}')">${t}</button>`).join('')}
function active(id){document.querySelectorAll('#nav button').forEach(x=>x.classList.remove('active'));const b=$('nav-'+id);if(b)b.classList.add('active')}
function go(id){active(id);({home,teachers,classesPage,subjectsPage,assign,studentsPage,addStudent,marksPage,reportsPage,attendancePage,settingsPage,myreport,myattendance,feesPage,noticesPage,storePage}[id]||home)()}
async function home(){active('home');if(me.role==='admin'){const d=await req('/admin/dashboard');$('main').innerHTML=`<div class="card"><h2>Admin Dashboard</h2><p class="muted">Full control of Al-Fauzan SMS.</p><div class="grid"><div class="card"><div>Teachers</div><div class="stat">${d.teachers}</div></div><div class="card"><div>Students</div><div class="stat">${d.students}</div></div><div class="card"><div>Classes</div><div class="stat">${d.classes}</div></div><div class="card"><div>Subjects</div><div class="stat">${d.subjects}</div></div></div><div class="card"><h3>Pending Teacher Approvals</h3>${d.pending.map(x=>`<p>${esc(x.name)} (${esc(x.username)}) <button onclick="approve(${x.id})">Approve</button> <button class="red" onclick="rejectT(${x.id})">Reject</button></p>`).join('')||'<p class="muted">No pending registrations.</p>'}</div><creator/></div>`}else{$('main').innerHTML=`<div class="card"><h2>Welcome, ${esc(me.name)}</h2><p>Your access is restricted to your ${me.role} account.</p><div class="creator"><img class="creator-photo" src="assets/creator.jpg"><div><b>Software Developer</b><br>Usman Adamu Auwal<br><span class="muted">Academic Session 2025/2026</span></div></div></div>`}}
function creator(){return `<div class="card"><div class="creator"><img class="creator-photo" src="assets/creator.jpg"><div><b>Software Developer</b><br>Usman Adamu Auwal<br><span class="muted">Al-Fauzan SMS • 2025/2026</span></div></div></div>`}
async function approve(id){await req('/admin/teachers/'+id+'/approve',{method:'POST'});home()}async function rejectT(id){await req('/admin/teachers/'+id+'/reject',{method:'POST'});home()}
async function teachers(){const d=await req('/admin/teachers');$('main').innerHTML=`<div class="card"><h2>Teachers</h2><div class="table-wrap"><table><tr><th>Name</th><th>Username</th><th>Email</th><th>Status</th></tr>${d.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.username)}</td><td>${esc(x.email||'')}</td><td>${esc(x.status)}</td></tr>`).join('')}</table></div></div>`}
async function classesPage(){const d=await req('/classes');$('main').innerHTML=`<div class="card"><h2>Classes</h2><div class="field"><input id="newClass" placeholder="e.g. Primary 1"></div><button onclick="addClass()">Add Class</button><div class="table-wrap" style="margin-top:15px"><table><tr><th>ID</th><th>Name</th></tr>${d.map(x=>`<tr><td>${x.id}</td><td>${esc(x.name)}</td></tr>`).join('')}</table></div></div>`}async function addClass(){await req('/classes',{method:'POST',body:JSON.stringify({name:$('newClass').value})});classesPage()}
async function subjectsPage(){const d=await req('/subjects');$('main').innerHTML=`<div class="card"><h2>Subjects</h2><div class="field"><input id="newSub" placeholder="Subject name"></div><button onclick="addSub()">Add Subject</button><div class="table-wrap" style="margin-top:15px"><table><tr><th>ID</th><th>Subject</th></tr>${d.map(x=>`<tr><td>${x.id}</td><td>${esc(x.name)}</td></tr>`).join('')}</table></div></div>`}async function addSub(){await req('/subjects',{method:'POST',body:JSON.stringify({name:$('newSub').value})});subjectsPage()}
async function assign(){const [t,c,s,a]=await Promise.all([req('/admin/teachers'),req('/classes'),req('/subjects'),req('/admin/assignments')]);$('main').innerHTML=`<div class="card"><h2>Teacher → Class → Subject</h2><div class="grid"><select id="at">${t.filter(x=>x.status==='active').map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select><select id="ac">${c.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select><select id="as">${s.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select></div><br><button onclick="saveAssign()">Assign</button></div><div class="card"><h3>Current Assignments</h3>${a.map(x=>`<p>${esc(x.teacher)} — ${esc(x.class_name)} — ${esc(x.subject)} <button class="red" onclick="delAssign(${x.id})">Delete</button></p>`).join('')||'<p class="muted">None</p>'}</div>`}async function saveAssign(){await req('/admin/assignments',{method:'POST',body:JSON.stringify({teacher_id:+$('at').value,class_id:+$('ac').value,subject_id:+$('as').value})});assign()}async function delAssign(id){await req('/admin/assignments/'+id,{method:'DELETE'});assign()}
async function studentsPage(){students=await req('/students');classes=await req('/classes');$('main').innerHTML=`<div class="card"><h2>${me.role==='admin'?'All Students':'My Students'}</h2>${me.role==='admin'?'<button onclick="addStudent()">➕ Add Student</button>':''}<div class="table-wrap"><table><tr><th>Name</th><th>Username</th><th>Class</th><th>Admission No.</th><th>Actions</th></tr>${students.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(s.username||'')}</td><td>${esc(s.class_name||'')}</td><td>${esc(s.admission_no||'')}</td><td><button onclick="marksFor(${s.id})">Marks</button> <button class="gold" onclick="report(${s.id})">Report</button></td></tr>`).join('')}</table></div></div>`}
async function addStudent(){classes=await req('/classes');$('main').innerHTML=`<div class="card"><h2>Add Student</h2><p class="muted">Teacher-created student accounts are active immediately. The student logs in with the username and password you give here.</p><div class="grid"><div class="field"><label>Student Full Name</label><input id="sn"></div><div class="field"><label>Username</label><input id="su"></div><div class="field"><label>Password</label><input id="sp" type="password"></div><div class="field"><label>Admission No.</label><input id="sa"></div><div class="field"><label>Class</label><select id="sc">${classes.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select></div></div><button onclick="saveStudent()">Create Student Account</button><div id="sm" class="notice hide"></div></div>`}
async function saveStudent(){try{await req('/students',{method:'POST',body:JSON.stringify({name:$('sn').value,username:$('su').value,password:$('sp').value,admission_no:$('sa').value,class_id:+$('sc').value})});msg('sm','Student account created successfully. Give the student the username and password.',true)}catch(e){msg('sm',e.message)}}
async function marksPage(){students=await req('/students');$('main').innerHTML=`<div class="card"><h2>Add / Edit Marks</h2><div class="field"><label>Student</label><select id="ms" onchange="loadMarksForm()">${students.map(s=>`<option value="${s.id}">${esc(s.name)} — ${esc(s.class_name||'')}</option>`).join('')}</select></div><div id="marksBox"></div></div>`;if(students.length)loadMarksForm()}
async function loadMarksForm(){const sid=+$('ms').value;const st=students.find(x=>x.id===sid);const all=await req('/subjects');const assigned=me.role==='teacher'?all:all;const rows=await req('/marks/'+sid);const by=new Map(rows.map(x=>[x.subject_id,x]));$('marksBox').innerHTML=`<div class="table-wrap"><table><tr><th>Subject</th><th>Test 1 /20</th><th>Test 2 /20</th><th>Exam /60</th><th>Manual Total</th><th>Manual Grade</th></tr>${assigned.map(x=>{const r=by.get(x.id)||{};return `<tr><td>${esc(x.name)}</td><td><input id="t1-${x.id}" type="number" min="0" max="20" value="${r.test1??0}"></td><td><input id="t2-${x.id}" type="number" min="0" max="20" value="${r.test2??0}"></td><td><input id="ex-${x.id}" type="number" min="0" max="60" value="${r.exam??0}"></td><td><input id="mt-${x.id}" type="number" min="0" max="100" placeholder="Auto"></td><td><select id="mg-${x.id}"><option value="">Automatic</option><option>ممتاز / Excellent</option><option>جيد جداً / Very Good</option><option>جيد / Good</option><option>مقبول / Pass</option><option>كسلان / Poor</option></select></td></tr>`}).join('')}</table></div><button style="margin-top:12px" onclick="saveMarks(${sid})">Save All Marks</button><div id="markMsg" class="notice hide"></div>`}
async function saveMarks(sid){try{const subs=await req('/subjects');for(const s of subs){await req('/marks',{method:'POST',body:JSON.stringify({student_id:sid,subject_id:s.id,test1:+$('t1-'+s.id).value||0,test2:+$('t2-'+s.id).value||0,exam:+$('ex-'+s.id).value||0,manual_total:$('mt-'+s.id).value,manual_grade:$('mg-'+s.id).value})})}msg('markMsg','All marks saved. Totals and grades update automatically.',true)}catch(e){msg('markMsg',e.message)}}
async function marksFor(id){go('marks');setTimeout(()=>{if($('ms')){$('ms').value=id;loadMarksForm()}},50)}
async function reportsPage(){students=await req('/students');$('main').innerHTML=`<div class="card"><h2>Report Cards</h2><div class="table-wrap"><table><tr><th>Student</th><th>Class</th><th>Action</th></tr>${students.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(s.class_name||'')}</td><td><button class="gold" onclick="report(${s.id})">Open / Print Report</button></td></tr>`).join('')}</table></div></div>`}
async function report(id){try{const d=await req('/reports/'+id);$('main').innerHTML=`<div class="report-page" id="report"><div class="report-inner"><div class="report-head"><div class="logos"><img class="report-logo" src="assets/logo.png"><div><div dir="rtl" style="font-weight:900">مركز الفوزان لتحفيظ القرآن والدراسات العامة</div><h1>${esc(d.school_name)}</h1><h2>FOR OUR QUR'AN AND GENERAL STUDIES</h2><div class="address">📍 ${esc(d.school_address)}</div></div><img class="report-logo" src="assets/logo.png"></div><div class="report-title">كشف الدرجات<br>REPORT SHEET</div></div><div class="student-info"><div>Name of Student / اسم الطالب: <u>${esc(d.student.name)}</u></div><div>Term / الفصل: <u>${esc(d.term)}</u></div><div>Date / التاريخ: <u>${esc(d.report_date)}</u></div><div>Class / الفصل: <u>${esc(d.student.class_name||'')}</u></div><div>Session / السنة الدراسية: <u>${esc(d.session)}</u></div><div>Admission No.: <u>${esc(d.student.admission_no||'')}</u></div></div><div class="table-wrap"><table class="report-table"><tr><th>S/N<br>م</th><th>SUBJECT / المادة</th><th>1st Test (20)</th><th>2nd Test (20)</th><th>Exam Score (60)</th><th>TOTAL (100)</th><th>GRADE / التقدير</th></tr>${d.rows.map((r,i)=>`<tr><td>${i+1}</td><td class="subject">${esc(r.subject)}</td><td>${r.test1}</td><td>${r.test2}</td><td>${r.exam}</td><td class="${r.fail?'poor':''}">${r.total}</td><td class="${r.fail?'poor':''}" style="color:${r.grade_color}">${esc(r.grade)}</td></tr>`).join('')}<tr><td colspan="5" style="font-weight:900">TOTAL SCORE / مجموع الدرجات</td><td style="font-weight:900" class="${d.overall_fail?'poor':''}">${d.total}</td><td class="${d.overall_fail?'poor':''}">${d.overall_fail?'راسب / FAIL':'ناجح / PASS'}</td></tr></table></div><div class="summary"><div>Position / الترتيب: <u>${esc(d.position||'')}</u></div><div>Out of / من: <u>${esc(d.out_of||'')}</u></div><div>Percentage / النسبة: <u>${esc(d.average)}%</u></div><div>Attendance / الحضور: <u>${esc(d.attendance||'')}</u></div><div>Pass/Fail / النتيجة: <span class="${d.overall_fail?'poor':''}">${d.overall_fail?'FAIL / راسب':'PASS / ناجح'}</span></div></div><div class="remarks"><b>Class Teacher's Remarks / ملاحظات معلم الفصل</b><div class="remark-line">${esc(d.teacher_remarks)}</div><div class="remark-line"></div><b>Headmaster's Remarks / ملاحظات المدير</b><div class="remark-line">${esc(d.headmaster_remarks)}</div><div class="remark-line"></div></div><div class="signs"><div><div class="sign-line"></div>Class Teacher's Signature<br>توقيع معلم الفصل</div><div><div class="sign-line"></div>Headmaster's Signature<br>توقيع المدير</div></div><div class="footer"><img class="creator-photo" src="assets/creator.jpg"><br>Software Developer: <b>${esc(d.developer_name)}</b> • ${esc(d.developer_year)}</div></div></div><div class="report-actions no-print">${d.report_held&&me.role!=='admin'?`<div class="notice err">🔒 This report is on HOLD by the Administrator. Printing is disabled.</div>`:`<button onclick="window.print()">🖨 Print / Save as PDF</button>`}${me.role!=='student'?`<button class="gold" onclick="editMeta(${id})">Manual Report Fields</button>`:''}${d.payment_link?`<a href="${esc(d.payment_link)}" target="_blank"><button class="gold">💳 School Payment</button></a>`:''}<button class="ghost" onclick="reportsPage()">Back</button></div>`}catch(e){$('main').innerHTML=`<div class="card err">${esc(e.message)}</div>`}}
async function editMeta(id){const m=await req('/report-meta/'+id);const position=prompt('Position',m.position||''),out=prompt('Out of',m.out_of||''),att=prompt('Attendance e.g. 20/24',m.attendance_override||''),tr=prompt("Teacher's remarks",m.teacher_remarks||''),hr=prompt("Headmaster's remarks",m.headmaster_remarks||''),date=prompt('Date YYYY-MM-DD',m.report_date||new Date().toISOString().slice(0,10));await req('/report-meta/'+id,{method:'PUT',body:JSON.stringify({position,out_of:out,attendance_override:att,teacher_remarks:tr,headmaster_remarks:hr,report_date:date})});report(id)}
async function attendancePage(){students=await req('/students');$('main').innerHTML=`<div class="card"><h2>Attendance</h2><div class="grid"><select id="ats">${students.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('')}</select><input id="atd" type="date" value="${new Date().toISOString().slice(0,10)}"><select id="atv"><option>Present</option><option>Absent</option><option>Late</option><option>Excused</option></select></div><br><button onclick="saveAttendance()">Save Attendance</button><div id="attMsg" class="notice hide"></div></div>`}
async function saveAttendance(){try{await req('/attendance',{method:'POST',body:JSON.stringify({student_id:+$('ats').value,date:$('atd').value,status:$('atv').value})});msg('attMsg','Attendance saved.',true)}catch(e){msg('attMsg',e.message)}}
async function feesPage(){
  const students=await req('/students');
  const rows=await req('/fees');
  if(me.role==='student'){
    const own=rows;
    $('main').innerHTML=`<div class="card"><h2>My Fees / Biyan Kuɗi</h2><div class="table-wrap"><table><tr><th>Description</th><th>Amount</th><th>Paid</th><th>Status</th><th>Date</th></tr>${own.map(x=>`<tr><td>${esc(x.description)}</td><td>${esc(x.amount)}</td><td>${esc(x.paid_amount)}</td><td>${esc(x.status)}</td><td>${esc(x.due_date||'')}</td></tr>`).join('')||'<tr><td colspan="5">No fee records.</td></tr>'}</table></div></div>`;return;
  }
  $('main').innerHTML=`<div class="card"><h2>Fees / Payments</h2><div class="grid"><div class="field"><label>Student</label><select id="feeStudent">${students.map(s=>`<option value="${s.id}">${esc(s.name)} — ${esc(s.class_name||'')}</option>`).join('')}</select></div><div class="field"><label>Description</label><input id="feeDesc" placeholder="School fees"></div><div class="field"><label>Amount</label><input id="feeAmount" type="number" min="0"></div><div class="field"><label>Paid Amount</label><input id="feePaid" type="number" min="0" value="0"></div><div class="field"><label>Due Date</label><input id="feeDate" type="date"></div></div><button onclick="saveFee()">Save Fee Record</button></div><div class="card"><div class="table-wrap"><table><tr><th>Student</th><th>Description</th><th>Amount</th><th>Paid</th><th>Status</th><th>Due</th></tr>${rows.map(x=>`<tr><td>${esc(x.student_name)}</td><td>${esc(x.description)}</td><td>${x.amount}</td><td>${x.paid_amount}</td><td>${esc(x.status)}</td><td>${esc(x.due_date||'')}</td></tr>`).join('')||'<tr><td colspan="6">No records.</td></tr>'}</table></div></div>`;
}
async function saveFee(){await req('/fees',{method:'POST',body:JSON.stringify({student_id:+$('feeStudent').value,description:$('feeDesc').value,amount:+$('feeAmount').value,paid_amount:+$('feePaid').value,due_date:$('feeDate').value||null})});feesPage()}
async function noticesPage(){const rows=await req('/notices');const canEdit=me.role==='admin';$('main').innerHTML=`<div class="card"><h2>School Notices</h2>${canEdit?`<div class="grid"><div class="field"><label>Title</label><input id="nt"></div><div class="field"><label>Message</label><textarea id="nm"></textarea></div><div class="field"><label>Audience</label><select id="na"><option>all</option><option>teacher</option><option>student</option></select></div></div><button onclick="saveNotice()">Publish Notice</button>`:''}</div><div class="card">${rows.map(x=>`<article style="border-bottom:1px solid var(--line);padding:12px 0"><h3>${esc(x.title)}</h3><p>${esc(x.message)}</p><small class="muted">Audience: ${esc(x.audience)} • ${esc(x.created_at||'')}</small></article>`).join('')||'<p>No notices.</p>'}</div>`}
async function saveNotice(){await req('/notices',{method:'POST',body:JSON.stringify({title:$('nt').value,message:$('nm').value,audience:$('na').value})});noticesPage()}
async function storePage(){const rows=await req('/inventory');const admin=me.role==='admin';$('main').innerHTML=`<div class="card"><h2>Store / Inventory</h2>${admin?`<div class="grid"><div class="field"><label>Item</label><input id="it"></div><div class="field"><label>Quantity</label><input id="iq" type="number" min="0"></div><div class="field"><label>Unit</label><input id="iu" value="pcs"></div><div class="field"><label>Reorder Level</label><input id="ir" type="number" min="0" value="5"></div></div><button onclick="saveItem()">Add / Update Item</button>`:''}</div><div class="card"><div class="table-wrap"><table><tr><th>Item</th><th>Quantity</th><th>Unit</th><th>Reorder Level</th><th>Status</th></tr>${rows.map(x=>`<tr><td>${esc(x.item_name)}</td><td>${x.quantity}</td><td>${esc(x.unit)}</td><td>${x.reorder_level}</td><td>${x.quantity<=x.reorder_level?'<b class="poor">LOW STOCK</b>':'OK'}</td></tr>`).join('')||'<tr><td colspan="5">No inventory items.</td></tr>'}</table></div></div>`}
async function saveItem(){await req('/inventory',{method:'POST',body:JSON.stringify({item_name:$('it').value,quantity:+$('iq').value,unit:$('iu').value,reorder_level:+$('ir').value})});storePage()}
async function settingsPage(){const d=await req('/admin/settings');$('main').innerHTML=`<div class="card"><h2>School Settings & System Control</h2><div class="grid"><div class="field"><label>School Name</label><input id="ssn" value="${esc(d.school_name||'')}"></div><div class="field"><label>Address</label><input id="ssa" value="${esc(d.school_address||'')}"></div><div class="field"><label>Session</label><input id="sss" value="${esc(d.session||'2025/2026')}"></div><div class="field"><label>Term</label><input id="sst" value="${esc(d.term||'First Term')}"></div><div class="field"><label>Developer Name</label><input id="sdn" value="${esc(d.developer_name||'Usman Adamu Auwal')}"></div><div class="field"><label>Developer Year</label><input id="sdy" value="${esc(d.developer_year||'2025/2026')}"></div><div class="field"><label>Payment Link</label><input id="spl" value="${esc(d.payment_link||'')}" placeholder="https://..."></div><div class="field"><label>Closed Message</label><input id="smm" value="${esc(d.maintenance_message||'')}"></div></div><label><input id="sopen" type="checkbox" ${d.system_open!==false?'checked':''}> Software Open</label><br><label><input id="rhold" type="checkbox" ${d.report_hold===true?'checked':''}> Hold Report Cards for teachers/students</label><br><button onclick="saveSettings()">Save Settings</button>${d.payment_link?`<p><a href="${esc(d.payment_link)}" target="_blank">Open Payment Link</a></p>`:''}</div>`}async function saveSettings(){await req('/admin/settings',{method:'PUT',body:JSON.stringify({school_name:$('ssn').value,school_address:$('ssa').value,session:$('sss').value,term:$('sst').value,developer_name:$('sdn').value,developer_year:$('sdy').value,payment_link:$('spl').value,maintenance_message:$('smm').value,system_open:$('sopen').checked,report_hold:$('rhold').checked})});alert('Settings saved.');settingsPage()}
async function myreport(){const s=(await req('/students'))[0];if(s)report(s.id);else $('main').innerHTML='<div class="card">No student profile is linked to this account yet.</div>'}
async function myattendance(){const s=(await req('/students'))[0];if(!s)return $('main').innerHTML='<div class="card">No student profile is linked.</div>';const d=await req('/attendance/'+s.id);$('main').innerHTML=`<div class="card"><h2>My Attendance</h2><div class="table-wrap"><table><tr><th>Date</th><th>Status</th></tr>${d.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.status)}</td></tr>`).join('')||'<tr><td colspan="2">No attendance records yet.</td></tr>'}</table></div></div>`}
function closeModal(){$('modal').classList.add('hide')}
if(token)openApp();
</script></body></html>
